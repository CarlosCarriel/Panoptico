  "Optimization": {
    "Ram1_Targets": [
      "PhoneExperienceHost",
      "StartMenuExperienceHost",
      "Widgets",
      "MicrosoftEdgeUpdate",
      "*nvidia*",
      "nvcontainer*",
      "NVDisplay*",
      "TextInputHost",
      "AcrobatNotificationClient",
      "cloudcode_cli",
